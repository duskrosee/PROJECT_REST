JWT_SECRET="change-me-to-a-long-random-secret"
APP_URL="http://localhost:3000"

# Optional override for automatic BenzynaMAPA fuel-price sync.
BENZYNAMAPA_PRICES_URL="https://benzynamapa.pl/data/prices_latest.json"
BENZYNAMAPA_STATIONS_URL="https://benzynamapa.pl/data/stations_latest.json"
BENZYNAMAPA_AUTO_SYNC_ENABLED="false"
BENZYNAMAPA_AUTO_SYNC_ON_STARTUP="false"
BENZYNAMAPA_AUTO_IMPORT_ON_STARTUP="false"
BENZYNAMAPA_AUTO_SYNC_INTERVAL_MINUTES="60"
BENZYNAMAPA_AUTO_IMPORT_LIMIT="100"
BENZYNAMAPA_FETCH_TIMEOUT_MS="30000"
